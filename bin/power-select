#!/bin/bash

GOLD="\e[38;2;217;159;21m"
RESET="\e[0m"

start() {
  clear
  while true; do

    printf "${GOLD}"
    printf """
 @@@@@@@   @@@@@@  @@@  @@@  @@@ @@@@@@@@ @@@@@@@ 
 @@!  @@@ @@!  @@@ @@!  @@!  @@! @@!      @@!  @@@
 @!@@!@!  @!@  !@! @!!  !!@  @!@ @!!!:!   @!@!!@! 
 !!:      !!:  !!!  !:  !!:  !!  !!:      !!: :!! 
  :        : :. :    ::.:  :::   : :: :::  :   : :
                                                  
"""
    printf "${RESET}"
    echo

    choice=$(
      gum choose \
        --selected.foreground="#d99f15" \
        --header.foreground="#d99f15" \
        --cursor.foreground="#d99f15" \
        "Shutdown" \
        "Reboot" \
        "Hibernate" \
        "Logout"
    )

    case "$choice" in
    "Shutdown")
      echo "Shutting down..."
      shutdown now
      break
      ;;
    "Reboot")
      echo "Rebooting"
      reboot
      break
      ;;
    "Hibernate")
      echo "Hibernating..."
      systemctl hibernate
      break
      ;;
    "Logout")
      echo "Logging out..."
      hyprctl dispatch 'hl.dsp.exit()'
      break
      ;;
    *)
      clear
      ;;
    esac
  done
}
start
